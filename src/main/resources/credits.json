{
  "//": "Everyone credited on the About screen. Read by CreditsRepository — the list is data, not code, so adding a translator is a one-line edit and needs no build.",
  "schema": [
    "github  — a GitHub login; the link and the avatar are derived from it",
    "name    — what to show, when it is not just the login",
    "url     — a link that is not a GitHub profile (Crowdin, a site)",
    "avatar  — a profile picture that is not the GitHub one",
    "role    — a key into the localized about_role_* strings, never free text",
    "badge   — a short label, not translated",
    "category— dev | translation | community",
    "order   — where the row sits; defaults to the end"
  ],
